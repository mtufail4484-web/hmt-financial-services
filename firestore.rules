rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUserOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
    }

    function isMasterOwner() {
      return signedIn()
        && (request.auth.uid == "fSJ0jUBCONXGJA7H41ChRq2ERLs1"
            || request.auth.email.toLowerCase() == "m.tufailkhan12335@gmail.com"
            || getUserData().role == "owner");
    }

    function isAdmin() {
      return isMasterOwner()
        || (signedIn() && (getUserData().role == "admin" || request.auth.token.admin == true));
    }

    function isTeacher() {
      return isAdmin()
        || (signedIn() && (getUserData().role == "teacher" || request.auth.token.teacher == true));
    }

    match /students/{userId} {
      allow read: if isUserOwner(userId) || isTeacher();
      allow create: if signedIn();
      allow update: if isUserOwner(userId) || isTeacher();
      allow delete: if isAdmin();
    }

    match /publicStudentVerifications/{rollNo} {
      allow get: if true;
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rollNo == rollNo
      );
      allow update: if isAdmin() || (
        isUserOwner(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.rollNo == rollNo
      );
      allow delete: if isAdmin();
    }

    match /courseLectures/{lectureId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isTeacher() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isUserOwner(resource.data.studentId) || isTeacher();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /aiCourseInterest/{docId} {
      allow read: if isUserOwner(docId) || isTeacher();
      allow create: if isUserOwner(docId) && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /metadata/student_counter {
      allow read: if true;
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.keys().hasOnly(["currentCount"])
        && request.resource.data.currentCount == 1
      );
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["currentCount"])
        && request.resource.data.currentCount == resource.data.currentCount + 1
      );
      allow delete: if isAdmin();
    }

    match /metadata/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
