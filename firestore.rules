rules_version = '2';

// ============================================================================
// HMT Success Academy — Firestore Security Rules (PROPOSAL v3 — NOT DEPLOYED)
// ----------------------------------------------------------------------------
// v3 additions requested by owner:
//   * watchedSeconds can only INCREASE (never reduced, never deleted)
//   * completed can only transition false -> true (never true -> false)
//   * once completed: completedAt / completionThreshold / requiredSecondsAtCompletion
//     are IMMUTABLE (cannot be changed or removed)
//   * per-lecture progress lives in students/{uid}/progress/{lectureId} so these
//     guarantees can be enforced per document for ANY lecture id (rules language
//     cannot iterate over map keys inside the parent document)
//
// HONEST LIMITATION (acknowledged by owner): completion is client-written, so a
// determined account owner can still FORGE a completion (set completed:true via
// an authenticated client). Rules prevent: removal, reduction, cross-student
// edits, threshold tampering, counter manipulation, and admin self-promotion.
// This is "tamper-resistant", NOT cheat-proof. Server-side validation is a
// future phase.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin = signed-in user whose Firebase Auth UID has a doc in "admins".
    // request.auth.uid comes from the verified, signed auth token — not
    // client-supplied, not forgeable.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- Student profile document: owner-only, progress-fields-only ----------
    match /students/{uid} {

      function isOwner() {
        return isSignedIn() && request.auth.uid == uid;
      }

      // Only these two fields may ever change on the profile document.
      // uid, name, email, quizScore, assignmentScore, createdAt: immutable
      // from any client.
      function touchesOnlyProgressFields() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['completedVideos', 'watchTimeMinutes']);
      }

      // completedVideos may only GROW (arrayUnion). Entries can never be
      // removed or replaced -> a recorded completion is permanent.
      function completedVideosNeverRemoved() {
        return !('completedVideos' in resource.data)
          || request.resource.data.completedVideos
               .hasAll(resource.data.completedVideos);
      }

      allow get: if isOwner();
      // Listing the students collection is ADMIN-ONLY -> blocks cross-student
      // reads AND makes getCountFromServer() admin-only (it needs "list").
      allow list: if isAdmin();

      // Registration: only your own doc, with your own uid and your own
      // verified auth email.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;

      allow update: if isOwner()
        && touchesOnlyProgressFields()
        && completedVideosNeverRemoved();

      // Student documents are never deletable from any client.
      allow delete: if false;

      // ---- Per-lecture progress: strictly monotonic, append-friendly ---------
      // Document shape (created by the portal on first watch):
      //   watchedSeconds: int (only ever increases)
      //   videoDurationSeconds: int (set once from the YouTube API, then immutable)
      //   completed: bool (false -> true only)
      //   completedAt / completionThreshold / requiredSecondsAtCompletion:
      //       stamped once at completion, then immutable
      //   updatedAt: timestamp
      match /progress/{lectureId} {

        function before() { return resource.data; }
        function after() { return request.resource.data; }

        // A field that has been set may keep its value or first appear, but
        // can never change and never be deleted (FieldValue.delete() produces
        // an error/absence here -> denied).
        function immutableOnceSet(field) {
          return !(field in before())
            || after()[field] == before()[field];
        }

        function watchedSecondsNeverDecreases() {
          return !('watchedSeconds' in before())
            || after().watchedSeconds >= before().watchedSeconds;
        }

        function completedNeverUncompletes() {
          return !('completed' in before())
            || !(before().completed == true && after().completed == false);
        }

        function touchesOnlyProgressDocFields() {
          return after().diff(before()).affectedKeys().hasOnly([
            'watchedSeconds',
            'videoDurationSeconds',
            'completed',
            'completedAt',
            'completionThreshold',
            'requiredSecondsAtCompletion',
            'updatedAt'
          ]);
        }

        allow get, list: if isOwner();

        allow create: if isOwner()
          && after().watchedSeconds is number
          && after().watchedSeconds >= 0
          && after().completed is bool;

        allow update: if isOwner()
          && touchesOnlyProgressDocFields()
          && watchedSecondsNeverDecreases()
          && completedNeverUncompletes()
          && immutableOnceSet('completedAt')
          && immutableOnceSet('completionThreshold')
          && immutableOnceSet('requiredSecondsAtCompletion')
          && immutableOnceSet('videoDurationSeconds');

        // Progress documents are never deletable from any client.
        allow delete: if false;
      }
    }

    // ---- Portal settings (lecture completion threshold) -----------------------
    // Signed-in users may READ. Only ADMINS may WRITE, and only an int 1..100.
    // A threshold change never rewrites student progress documents, so past
    // completions (stamped with their own threshold) are untouched.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && request.resource.data.lectureCompletionThreshold is int
        && request.resource.data.lectureCompletionThreshold >= 1
        && request.resource.data.lectureCompletionThreshold <= 100;
    }

    // ---- Admin registry: UID-keyed, self-check read only -----------------------
    // Created/managed ONLY in the Firebase console (console bypasses rules).
    // Students cannot create, alter, or enumerate admin records.
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // ---- Public counter: a number, zero PII -------------------------------------
    match /stats/{docId} {
      allow read: if true;
      allow create, delete: if false;
      // Signed-up students may bump the count by EXACTLY +1 (plus metadata).
      // Decreasing or jumping by more than 1 is denied. Admins may set any
      // value ("Sync real count").
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.count == resource.data.count + 1
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['count', 'updatedAt', 'updatedBy']));
    }

    // ---- Default deny -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
