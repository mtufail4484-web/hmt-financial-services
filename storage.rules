rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && (
          request.auth.uid == "fSJ0jUBCONXGJA7H41ChRq2ERLs1"
          || request.auth.token.email.toLowerCase() == "m.tufailkhan12335@gmail.com"
          || request.auth.token.admin == true
          || request.auth.token.teacher == true
        );
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.uid == "fSJ0jUBCONXGJA7H41ChRq2ERLs1"
          || request.auth.token.email.toLowerCase() == "m.tufailkhan12335@gmail.com"
          || request.auth.token.admin == true
        );
    }

    match /profilePhotos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isTeacher() || (signedIn() && request.auth.uid == userId);
    }

    match /assignments/{userId}/{allPaths=**} {
      allow read, write: if isTeacher() || (signedIn() && request.auth.uid == userId);
    }

    match /announcements/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /practice-materials/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
